{
  "extends": [
    "config:base",
    ":semanticCommits"
  ],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Auto-merge every dependency update once checks pass (fleet policy, same as github>sneat-co/cicd). Later rules in this list still opt specific updates out.",
      "automerge": true
    },
    {
      "groupName": "go toolchain",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang"],
      "separateMinorPatch": true,
      "separateMultipleMajor": true,
      "automerge": false
    },
    {
      "groupName": "go toolchain patches",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "groupName": "go",
      "matchPackagePatterns": [
        "go"
      ],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "groupName": "dalgo & strongo non major deps",
      "groupSlug": "dalgo-strongo-minor-patch",
      "matchPackagePatterns": [
        "github.com/dal-go/",
        "github.com/strongo/"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "groupName": "3d-parties",
      "groupSlug": "3d-parties",
      "matchManagers": ["gomod"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "go-github major updates require a separate AI migration",
      "matchManagers": ["gomod"],
      "matchPackagePatterns": ["^github\\.com/google/go-github(/v[0-9]+)?$"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Separate PR for every GitHub Actions update",
      "matchManagers": ["github-actions"],
      "groupName": null
    },
    {
      "description": "Go modules move by release tag, never by commit digest (founder, 2026-11-28; see sneat-co/sneat-core-modules#454). Scoped to our own orgs, which tag their releases: a third-party module with no tags can still only move by digest. A module required at a pseudo-version gets its next release tag proposed instead.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/sneat-co/**", "github.com/dal-go/**", "github.com/strongo/**", "github.com/datatug/**", "github.com/ingitdb/**", "github.com/bots-go-framework/**"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ]
}
