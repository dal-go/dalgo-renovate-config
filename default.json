{
  "extends": [
    "config:base",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "groupName": "go toolchain",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang"],
      "separateMinorPatch": true,
      "separateMultipleMajor": true,
      "automerge": false
    },
    {
      "groupName": "go toolchain patches",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "groupName": "go",
      "matchPackagePatterns": [
        "go"
      ],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "groupName": "dalgo & strongo non major deps",
      "groupSlug": "dalgo-strongo-minor-patch",
      "matchPackagePatterns": [
        "github.com/dal-go/",
        "github.com/strongo/"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "groupName": "3d-parties",
      "groupSlug": "3d-parties",
      "matchManagers": ["gomod"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "go-github major updates require a separate AI migration",
      "matchManagers": ["gomod"],
      "matchPackagePatterns": ["^github\\.com/google/go-github(/v[0-9]+)?$"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Separate PR for every GitHub Actions update",
      "matchManagers": ["github-actions"],
      "groupName": null
    }
  ]
}
